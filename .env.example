# ===========================================
# Amina Bot - Environment Variables
# ===========================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# --- OpenRouter AI ---
OPENROUTER_API_KEY=your_openrouter_api_key

# --- Perplexity (MCP web search, cheapest model: sonar) ---
PERPLEXITY_API_KEY=your_perplexity_api_key

# --- Appwrite ---
APPWRITE_ENDPOINT=https://appwrite.vibecoding.by/v1
APPWRITE_PROJECT_ID=69af2faa003646d3574c
APPWRITE_API_KEY=your_api_key_here
APPWRITE_DATABASE_ID=amina

# --- Render ---
RENDER_API_KEY=your_render_api_key

# --- Server ---
PORT=3000
NODE_ENV=development
TZ=UTC
WEBHOOK_URL=https://your-app.onrender.com
WEBHOOK_SECRET=random_secret_string

# --- URLs (опционально, по умолчанию Render) ---
# ADMIN_URL=https://amina-admin.onrender.com
# BOT_URL=https://amina-bot.onrender.com

# --- LM Studio (локальные модели через туннель) ---
LMSTUDIO_API_KEY=  # Токен из LM Studio (Developers → Manage Tokens), если включена авторизация
LMSTUDIO_TUNNEL_TOKEN=generate_a_shared_secret_for_tunnel_scripts_and_Render
# TUNNEL_PROVIDER=auto
# LOCALTUNNEL_ARGS=-y localtunnel@2.0.2 --port 1234

# --- Leads (заявки с сайтов) ---
# Домены, которым разрешено слать заявки через /api/leads (через запятую)
LEAD_ORIGINS=https://vibecoding.by
