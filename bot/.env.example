# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# OpenRouter AI
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=anthropic/claude-3-haiku

# Appwrite
APPWRITE_ENDPOINT=https://appwrite.vibecoding.by/v1
APPWRITE_PROJECT_ID=69af2faa003646d3574c
APPWRITE_API_KEY=your_appwrite_api_key
APPWRITE_DATABASE_ID=amina

# Публичный URL бота (https) — нужен для Telegram Web App / мини-приложения и кнопки меню.
# В @BotFather: /setdomain → тот же хост без пути (например amina.vibecoding.by)
# BOT_URL=https://amina.vibecoding.by

# Server
# Таймаут HTTP (мс). Мини-апп: при 502 увеличьте здесь и read_timeout у reverse-proxy (Coolify/nginx).
# REQUEST_TIMEOUT_MS=120000
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Доверие к X-Forwarded-For (влияет на request.ip и rate-limiting).
# В проде задайте ТОЧНОЕ число reverse-proxy хопов (например, 1 для одного nginx/cloudflared),
# иначе клиент сможет подделать X-Forwarded-For и обойти rate-limit.
# Допустимо: число хопов | true (доверять всей цепочке, небезопасно) | false | IP/CIDR.
TRUST_PROXY=true

# Webhook (production only)
# WEBHOOK_URL=https://your-app.example.com
# WEBHOOK_SECRET=your_secret

# LM Studio tunnel control plane
# LMSTUDIO_TUNNEL_TOKEN=generate_a_shared_secret_for_tunnel_scripts_and_Render

# ============================================================
# Telephony — LiraX ATS integration
# Все значения ниже переопределяются настройками из БД (amina_settings).
# Переменные окружения служат fallback-ом если в БД значение не задано.
# ============================================================

# LiraX API
# LIRAX_URL=https://api.lirax.net/general
# LIRAX_TOKEN=your_lirax_api_token
# LIRAX_WEBHOOK_TOKEN=your_lirax_webhook_verification_token
# LIRAX_DEFAULT_EXT=201
# LIRAX_OPERATOR_PHONE=+7XXXXXXXXXX

# LiraX уведомления и chat ID-ы
# LIRAX_ADMIN_CHAT_ID=your_telegram_chat_id
# LIRAX_OWNER_CHAT_ID=your_telegram_chat_id
# LIRAX_NOTIFY_CALLS=true
# LIRAX_NOTIFY_RECORDS=true

# SIP-аккаунт (используется realtime media bridge для исходящих вызовов)
# TELEPHONY_SIP_SERVER=lira.lirax.net
# TELEPHONY_SIP_LOGIN=1129570
# TELEPHONY_SIP_PASSWORD=your_sip_password
# TELEPHONY_EXTERNAL_NUMBER=+7XXXXXXXXXX

# Realtime Media Bridge
# TELEPHONY_REALTIME_ENABLED=false
# TELEPHONY_MEDIA_BRIDGE_URL=https://bridge.example.com
# TELEPHONY_MEDIA_BRIDGE_TOKEN=your_bridge_bearer_token
# TELEPHONY_MEDIA_BRIDGE_HEALTH_URL=https://bridge.example.com/health

# Telephony AI — модель OpenRouter для голосового контура
# Приоритет: DB -> env -> модель из общих настроек ai
# TELEPHONY_AI_PROVIDER=inherit
# TELEPHONY_OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Telephony tuning
# TELEPHONY_LATENCY_BUDGET_MS=1800
# TELEPHONY_RECORDINGS_ARCHIVE_ENABLED=true
# TELEPHONY_PARTIAL_TRANSCRIPT_ENABLED=true
# TELEPHONY_RECORDING_RETENTION_DAYS=30
