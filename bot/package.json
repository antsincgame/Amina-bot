{
  "name": "amina-bot",
  "version": "1.0.0",
  "description": "Telegram AI Bot with Voice Support (Zadarma + Vosk + Silero)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "grammy": "^1.21.1",
    "fastify": "^4.26.0",
    "@fastify/cors": "^9.0.1",
    "@supabase/supabase-js": "^2.39.3",
    "openai": "^4.28.0",
    "vosk": "^0.3.45",
    "zod": "^3.22.4",
    "dotenv": "^16.4.1",
    "pino": "^8.18.0",
    "pino-pretty": "^10.3.1",
    "node-fetch": "^3.3.2",
    "form-data": "^4.0.0",
    "fluent-ffmpeg": "^2.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "@types/fluent-ffmpeg": "^2.1.24",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "vitest": "^1.2.2",
    "@vitest/coverage-v8": "^1.2.2",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
