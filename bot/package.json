{
  "name": "amina-bot",
  "version": "1.0.0",
  "description": "Telegram AI bot with OpenRouter and Appwrite",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "echo 'Using tsx runtime'",
    "start": "tsx src/index.ts",
    "sync:news": "tsx scripts/sync-news-sources.ts",
    "sync:news:asia": "tsx scripts/sync-news-sources.ts asia",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^8.3.1",
    "@fastify/static": "^7.0.4",
    "@huggingface/inference": "^4.13.11",
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.1",
    "fastify": "^4.26.0",
    "grammy": "^1.21.1",
    "msedge-tts": "^2.0.4",
    "node-appwrite": "^13.0.0",
    "openai": "^4.28.0",
    "pino": "^8.18.0",
    "pino-pretty": "^10.3.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^1.2.2",
    "eslint": "^8.56.0",
    "vitest": "^1.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
