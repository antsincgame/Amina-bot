{
  "name": "amina-bot",
  "version": "1.0.0",
  "description": "Telegram AI Bot with OpenRouter and Supabase",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "echo 'No build step needed - using tsx'",
    "start": "tsx src/index.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@huggingface/inference": "^4.13.11",
    "@supabase/supabase-js": "^2.39.3",
    "dotenv": "^16.4.1",
    "fastify": "^4.26.0",
    "grammy": "^1.21.1",
    "msedge-tts": "^2.0.4",
    "openai": "^4.28.0",
    "pino": "^8.18.0",
    "pino-pretty": "^10.3.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^1.2.2",
    "eslint": "^8.56.0",
    "vitest": "^1.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
