# Amina LM Studio Tunnel — конфиг
# Скопируй этот файл в .env и заполни реальные значения.
# НИКОГДА не коммить .env в git.

# Токен аутентификации туннеля (обязательно).
# Получи у администратора бота или сгенерируй: openssl rand -base64 32
LMSTUDIO_TUNNEL_TOKEN=

# URL бота (по умолчанию: https://amina.vibecoding.by)
# BOT_API_URL=https://amina.vibecoding.by

# Порт LM Studio на локальной машине (по умолчанию: 1234)
# LMSTUDIO_PORT=1234
