AMINA_AVATAR_SECRET=придумайте_длинный_случайный_секрет
AVATAR_PORT=8765

# ffmpeg — только картинка+звук (CPU). wav2lip — липсинк на GPU (образ Dockerfile.gpu).
AVATAR_ENGINE=ffmpeg

# Опционально для wav2lip (тюнинг лица)
# WAV2LIP_CHECKPOINT=checkpoints/wav2lip_gan.pth
# WAV2LIP_PADS=0 20 0 0
# WAV2LIP_RESIZE_FACTOR=1
# WAV2LIP_NOSMOOTH=0

# Запуск туннеля одной командой (см. start-windows.ps1 -Tunnel)
# CLOUDFLARED_BIN=cloudflared

# Ссылка «Открыть мини-приложение» на локальной веб-панели (http://127.0.0.1:8765/)
# MINI_APP_URL=https://amina.vibecoding.by/mini-app/index.html
