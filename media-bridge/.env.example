# Amina Media Bridge — переменные окружения
# Скопируй в .env и подставь значения

# ── Bridge сервер ──
PORT=3100
BRIDGE_TOKEN=amina-bridge-secret
AMINA_BOT_URL=https://amina.vibecoding.by

# ── FreeSWITCH ESL ──
ESL_HOST=127.0.0.1
ESL_PORT=8022
ESL_PASSWORD=ClueCon

# ── FreeSWITCH SIP (LiraX) ──
# Подставь в config/freeswitch/vars.xml
# lirax_sip_server=lira.lirax.net
# lirax_sip_login=1129570
# lirax_sip_password=<пароль из кабинета LiraX>

# ── Логирование ──
LOG_LEVEL=info
