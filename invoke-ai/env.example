# Скопируйте в .env и подставьте значения.
# cp env.example .env

# Где на СЕРВЕРЕ хранить модели и вывод (абсолютный путь надёжнее).
HOST_INVOKEAI_ROOT=/var/lib/invokeai

# Порт веб-интерфейса InvokeAI.
INVOKEAI_PORT=9090

# Внутри контейнера (обычно не меняют).
CONTAINER_INVOKEAI_ROOT=/invokeai

# Токен Hugging Face — нужен для загрузки моделей из UI/менеджера.
# https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# Кэш HF на хосте (опционально).
# HF_HOME=/var/lib/invokeai-hf-cache
